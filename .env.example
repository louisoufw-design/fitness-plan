# Copy to .env and fill in real values. Never commit .env.
#
# The current app needs NO environment variables: it is a single static HTML file,
# and sync is handled by the Claude runtime when opened inside Claude.

# ---- tests
# 0 = show the browser window while tests run; 1 = headless (default)
HEADLESS=1

# ---- reserved for a future self-hosted database (NOT read by the current code)
# Anything shipped to the browser is public: only use client-side keys here
# (e.g. Firebase Web API key, Supabase anon key) and protect data with database rules.
DB_PROVIDER=YOUR_DB_PROVIDER
DB_URL=YOUR_DB_URL
DB_PUBLIC_API_KEY=YOUR_API_KEY
AUTH_PROJECT_ID=YOUR_PROJECT_ID
